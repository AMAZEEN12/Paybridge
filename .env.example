# Copy these into your shell or IDE run configuration. Never commit real values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paybridge
DB_USER=postgres
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
PAYSTACK_SECRET_KEY=
# SPRING_PROFILES_ACTIVE=paystack   # use the real Paystack test gateway instead of the fake one

# Open Exchange Rates app id. Only needed with PAYBRIDGE_FX_PROVIDER=openexchangerates. Default is the stub.
OXR_APP_ID=
# PAYBRIDGE_FX_PROVIDER=stub

# PAYBRIDGE_PAYOUT_PROVIDER=flutterwave   # real Flutterwave client; fake by default
# FLUTTERWAVE_SECRET_KEY=                 # use the TEST key
# FLUTTERWAVE_WEBHOOK_SECRET=             # same value as the secret hash in the Flutterwave dashboard
# FLUTTERWAVE_RATE_MODE=OWN_LOCK
